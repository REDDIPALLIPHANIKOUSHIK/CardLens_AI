APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000
# On Vercel same-origin deployment, leave VITE_API_BASE_URL unset; production calls /api/... .
POSTGRES_PASSWORD=cardlens-dev-only
# Development example only. Replace this for any shared deployment.
DATABASE_URL=postgresql+psycopg://cardlens:cardlens@localhost:5432/cardlens
# Vercel/serverless: keep per-instance connection use small; use your DB provider's pooled URL.
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=0
FRONTEND_ORIGINS=http://localhost:5173
# Production Vercel: set FRONTEND_ORIGINS=https://cardlensai.vercel.app (replace with the final HTTPS domain if different).
API_RATE_LIMIT_PER_MINUTE=60
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_NAME=alloy
